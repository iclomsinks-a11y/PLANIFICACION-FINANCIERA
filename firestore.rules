rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidUserWorkspace(data, userId) {
      return data.keys().hasAll(['uid', 'activeSupuestoId', 'nextSupuestoNumber', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'activeSupuestoId',
          'nextSupuestoNumber',
          'dismissedGmailIds',
          'updatedAt'
        ])
        && data.uid == userId
        && data.activeSupuestoId is string
        && data.activeSupuestoId.size() >= 1
        && data.activeSupuestoId.size() <= 128
        && data.nextSupuestoNumber is int
        && data.nextSupuestoNumber >= 1
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('dismissedGmailIds' in data) || (data.dismissedGmailIds is list && data.dismissedGmailIds.size() <= 500))
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidSupuesto(data, userId, supuestoId) {
      return data.keys().hasAll(['id', 'ownerUid', 'numero', 'nombre', 'updatedAt', 'state'])
        && data.keys().hasOnly(['id', 'ownerUid', 'numero', 'nombre', 'updatedAt', 'state'])
        && data.id == supuestoId
        && data.ownerUid == userId
        && data.numero is int
        && data.numero >= 1
        && data.nombre is string
        && data.nombre.size() >= 1
        && data.nombre.size() <= 120
        && data.state is map
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserWorkspace(request.resource.data, userId);
      allow update: if isVerifiedUser()
        && isOwner(userId)
        && isValidUserWorkspace(request.resource.data, userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'displayName',
          'activeSupuestoId',
          'nextSupuestoNumber',
          'dismissedGmailIds',
          'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isVerifiedUser() && isOwner(userId);

      match /supuestos/{supuestoId} {
        allow read: if isOwner(userId);
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(supuestoId)
          && isValidSupuesto(request.resource.data, userId, supuestoId);
        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(supuestoId)
          && isValidSupuesto(request.resource.data, userId, supuestoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'numero',
            'nombre',
            'updatedAt',
            'state'
          ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isVerifiedUser() && isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
